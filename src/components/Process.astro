---
import Logo from './Logo.astro';
const steps = [
  { n: '01', t: 'Despegue', d: 'Nos contás la idea, tu marca, el público y dónde va a vivir el video.' },
  { n: '02', t: 'Guion y ruta', d: 'Escribimos ganchos y guiones, armamos referencias y un plan de entregas.' },
  { n: '03', t: 'Rodaje', d: 'Filmamos y grabamos el audio en tu espacio. Si ya tenés material, salteamos esta parada.' },
  { n: '04', t: 'Edicion', d: 'Montaje, motion, color y sonido. Revisiones por etapa.' },
  { n: '05', t: 'Aterrizaje', d: 'Entregamos versiones para cada red, listas para publicar.' },
];
---
<section class="section process" id="proceso" aria-labelledby="proceso-title">
  <p class="eyebrow reveal">Proceso</p>
  <h2 class="section__title reveal" id="proceso-title">La ruta del video</h2>
  <p class="section__lede reveal">Seguí a la nube: así viaja un proyecto desde la idea hasta tu feed.</p>
  <div class="route">
    <svg class="route__svg" aria-hidden="true"><path class="route__base" /><path class="route__line" /></svg>
    <div class="rider" aria-hidden="true"><span><Logo size={52} /></span></div>
    <ol>
      {steps.map((s) => (
        <li class="step">
          <span class="node pixel" aria-hidden="true">{s.n}</span>
          <div class="step__card">
            <h3 class="pixel">{s.t}</h3>
            <p>{s.d}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  // camino que se ilumina con el scroll; la nube viaja en la punta y enciende cada parada
  const route = document.querySelector<HTMLElement>('.route')!;
  const svg = route.querySelector('svg')!;
  const base = route.querySelector<SVGPathElement>('.route__base')!;
  const line = route.querySelector<SVGPathElement>('.route__line')!;
  const rider = route.querySelector<HTMLElement>('.rider')!;
  const steps = [...route.querySelectorAll<HTMLElement>('.step')];
  let len = 0;
  let nodes: { x: number; y: number }[] = [];

  const build = () => {
    const box = route.getBoundingClientRect();
    const w = box.width, h = box.height;
    svg.setAttribute('viewBox', `0 0 ${w} ${h}`);
    nodes = steps.map((s) => {
      const r = s.querySelector('.node')!.getBoundingClientRect();
      return { x: r.left + r.width / 2 - box.left, y: r.top + r.height / 2 - box.top };
    });
    const amp = w < 760 ? 0 : Math.min(w * 0.2, 200);
    const pts = [{ x: nodes[0].x, y: 0 }, ...nodes, { x: nodes[0].x, y: h }];
    let d = `M${pts[0].x} ${pts[0].y}`;
    for (let i = 1; i < pts.length; i++) {
      // cada tramo se curva hacia el lado vacío de la parada que deja (textos pares a la izquierda)
      const a = pts[i - 1], b = pts[i], dy = b.y - a.y, s = i < 2 || i % 2 === 0 ? 1 : -1;
      const k = s * Math.min(amp, dy * 0.5);
      d += ` C${a.x + k} ${a.y + dy * 0.2} ${b.x + k} ${b.y - dy * 0.2} ${b.x} ${b.y}`;
    }
    base.setAttribute('d', d);
    line.setAttribute('d', d);
    len = line.getTotalLength();
    line.style.strokeDasharray = `${len}`;
    update();
  };

  const update = () => {
    const r = route.getBoundingClientRect();
    const p = Math.min(Math.max((innerHeight * 0.55 - r.top) / r.height, 0), 1);
    line.style.strokeDashoffset = `${len * (1 - p)}`;
    const at = line.getPointAtLength(len * p);
    const ahead = line.getPointAtLength(Math.min(len, len * p + 2));
    const tilt = Math.max(-18, Math.min(18, (ahead.x - at.x) * 9));
    rider.style.transform = `translate(${at.x}px, ${at.y}px) rotate(${tilt}deg)`;
    rider.classList.toggle('is-flying', p > 0 && p < 1);
    steps.forEach((s, i) => s.classList.toggle('is-lit', at.y >= nodes[i].y - 4));
  };

  addEventListener('scroll', update, { passive: true });
  addEventListener('resize', build);
  addEventListener('load', build);
  build();
</script>

<style>
  .process {
    overflow: hidden;
    background:
      radial-gradient(60% 40% at 50% 60%, rgba(67, 16, 95, .7), rgba(67, 16, 95, 0) 70%);
  }
  .process > .eyebrow, .process > .section__title, .process > .section__lede { text-align: center; margin-left: auto; margin-right: auto; }
  .route { position: relative; max-width: 1040px; margin: 3rem auto 0; padding: 2rem 0 3rem; }
  .route__svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .route__svg path { fill: none; stroke-linecap: square; }
  .route__base { stroke: rgba(180, 140, 255, .28); stroke-width: 3; stroke-dasharray: 4 10; }
  .route__line { stroke: var(--cyan); stroke-width: 4; filter: drop-shadow(0 0 6px var(--cyan)); }

  .rider { position: absolute; left: 0; top: 0; z-index: 2; width: 0; height: 0; pointer-events: none; }
  .rider span { position: absolute; left: -26px; top: -40px; display: block; filter: drop-shadow(0 0 14px rgba(97, 247, 231, .55)); }
  .rider.is-flying span { animation: bob 1.4s steps(4) infinite; }
  @keyframes bob { 50% { transform: translateY(-5px); } }

  ol { list-style: none; position: relative; display: grid; gap: clamp(5rem, 12vh, 8rem); }
  .step { position: relative; width: 50%; padding-right: 4rem; text-align: right; }
  .step:nth-child(even) { margin-left: 50%; padding: 0 0 0 4rem; text-align: left; }
  .node {
    position: absolute; top: -6px; right: -25px; z-index: 1; display: grid; place-items: center; width: 50px; height: 50px; font-size: .7rem;
    background: var(--ink); border: 3px solid rgba(180, 140, 255, .4); color: var(--lavender); transition: border-color .4s, color .4s, box-shadow .4s;
  }
  .step:nth-child(even) .node { right: auto; left: -25px; }
  .step.is-lit .node { border-color: var(--cyan); color: var(--cyan); box-shadow: 0 0 22px -4px var(--cyan); }

  .step__card { opacity: .12; transform: translateX(-70px); transition: opacity .8s var(--ease), transform .8s var(--ease); }
  .step:nth-child(even) .step__card { transform: translateX(70px); }
  .step.is-lit .step__card { opacity: 1; transform: none; }
  .step h3 { font-size: clamp(.85rem, 1.6vw, 1.1rem); margin-bottom: .8rem; color: var(--peach); }
  .step p { opacity: .82; max-width: 34ch; display: inline-block; }

  @media (max-width: 760px) {
    .route { margin-top: 3rem; }
    .step, .step:nth-child(even) { width: auto; margin-left: 0; padding: 0 0 0 4.5rem; text-align: left; }
    .step .node, .step:nth-child(even) .node { left: 0; right: auto; }
    .step__card, .step:nth-child(even) .step__card { transform: translateX(40px); }
  }
</style>
