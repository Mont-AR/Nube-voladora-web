---
import Logo from './Logo.astro';
---
<header class="header">
  <a href="#inicio" class="brand" aria-label="Nube Voladora, inicio">
    <Logo />
    <span class="pixel">NUBE<br />VOLADORA</span>
  </a>
  <nav class="nav" aria-label="Principal">
    <a href="#servicios">Servicios</a>
    <a href="#trabajos">Trabajos</a>
    <a href="#proceso">Proceso</a>
    <a href="#contacto" class="btn btn--magenta">Cotizar</a>
  </nav>
</header>
<style>
  .header {
    position: fixed; inset: 0 0 auto; z-index: 50; display: flex; justify-content: space-between; align-items: center;
    padding: 1.2rem clamp(16px, 4vw, 2.5rem);
    background: linear-gradient(180deg, rgba(7,17,57,.75), rgba(7,17,57,0));
  }
  .brand { display: flex; align-items: center; gap: .7rem; }
  .brand span { font-size: .62rem; line-height: 1.5; }
  .nav { display: flex; align-items: center; gap: 1.6rem; font-size: .9rem; }
  .nav a:not(.btn) { opacity: .85; transition: opacity .2s, color .2s; }
  .nav a:not(.btn):hover { opacity: 1; color: var(--cyan); }
  .nav .btn { padding: .7rem 1rem; margin: 0 4px 4px 0; }
  @media (max-width: 760px) { .nav a:not(.btn) { display: none; } }
</style>
