<div class="cursor" aria-hidden="true"></div>
<script>
  const c = document.querySelector<HTMLElement>('.cursor')!;
  if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let x = innerWidth / 2, y = innerHeight / 2, cx = x, cy = y;
    addEventListener('mousemove', (e) => { x = e.clientX; y = e.clientY; c.classList.add('is-on'); });
    document.addEventListener('mouseleave', () => c.classList.remove('is-on'));
    document.addEventListener('mouseover', (e) => {
      c.classList.toggle('is-hover', !!(e.target as Element).closest('a, button'));
    });
    const tick = () => {
      cx += (x - cx) * 0.18; cy += (y - cy) * 0.18;
      c.style.transform = `translate(${cx}px, ${cy}px)`;
      requestAnimationFrame(tick);
    };
    tick();
  }
</script>
<style>
  .cursor {
    position: fixed; top: -17px; left: -17px; width: 34px; height: 34px; z-index: 200;
    border: 1.5px solid var(--ink); border-radius: 50%; pointer-events: none;
    opacity: 0; transition: opacity .3s, width .4s var(--ease), height .4s var(--ease), top .4s var(--ease), left .4s var(--ease), background .4s;
    mix-blend-mode: difference; border-color: #fff;
  }
  .cursor.is-on { opacity: 1; }
  .cursor.is-hover { width: 64px; height: 64px; top: -32px; left: -32px; background: #fff; }
  :global(body.cursor-grab) .cursor { width: 64px; height: 64px; top: -32px; left: -32px; background: #fff; }
</style>
