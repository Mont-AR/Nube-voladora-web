---
import { SITE, WA_LINK } from '../data/site';
---
<section class="section contact" id="contacto" aria-labelledby="contacto-title">
  <div class="contact__inner">
    <div>
      <p class="eyebrow reveal">Contacto</p>
      <h2 class="section__title reveal" id="contacto-title">¿Tenés material?<br /><span>Lo hacemos volar.</span></h2>
      <p class="section__lede reveal">Contanos qué necesitás y te respondemos con una propuesta en 48 h.</p>
      <div class="direct reveal">
        <a href={WA_LINK} class="btn btn--whatsapp" target="_blank" rel="noopener">WhatsApp ▶</a>
        <span>o escribinos por el formulario</span>
      </div>
    </div>
    <form class="form reveal" action={`mailto:${SITE.email}`} aria-label="Formulario de contacto" method="post" enctype="text/plain">
      <label>Nombre<input name="nombre" required autocomplete="name" /></label>
      <label>Email<input name="email" type="email" required autocomplete="email" /></label>
      <label>Tipo de proyecto
        <select name="tipo">
          <option>Pack de Reels</option><option>Edición</option><option>Motion</option><option>Contenido para redes</option><option>Color</option><option>No sé todavía</option>
        </select>
      </label>
      <label>Mensaje<textarea name="mensaje" rows="4" placeholder="Quiero un pack de 8 reels por mes para mi marca…"></textarea></label>
      <button class="btn btn--cyan" type="submit">Enviar ▶</button>
    </form>
  </div>
</section>
<script>
  // los CTA con data-tipo preseleccionan el tipo de proyecto
  const tipo = document.querySelector<HTMLSelectElement>('.form select[name="tipo"]')!;
  document.querySelectorAll<HTMLElement>('[data-tipo]').forEach((el) =>
    el.addEventListener('click', () => (tipo.value = el.dataset.tipo!)),
  );
</script>
<style>
  .contact { background: linear-gradient(180deg, transparent, rgba(67, 16, 95, .8) 60%, color-mix(in srgb, var(--magenta) 55%, rgb(67, 16, 95))); }
  .contact__inner { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: start; }
  .section__title span { color: var(--peach); }
  .form { display: grid; gap: 1rem; padding: 2rem; background: rgba(7,17,57,.7); border: 2px solid rgba(180,140,255,.3); }
  label { display: grid; gap: .4rem; font-size: .8rem; color: var(--lavender); }
  input, select, textarea {
    background: var(--ink); border: 2px solid var(--indigo); padding: .75rem .8rem; color: var(--cream); font-size: .95rem;
  }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--cyan); }
  .form .btn { justify-self: start; }
  .direct { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.4rem; margin-top: 2rem; }
  .direct span { font-size: .8rem; opacity: .7; }
  .btn--whatsapp { --bg: #25d366; --fg: var(--ink); --bc: #b9f5d0; --sh: var(--violet); }
  @media (max-width: 860px) { .contact__inner { grid-template-columns: 1fr; } .form { padding: 1.3rem; } }
</style>
