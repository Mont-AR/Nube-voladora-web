---
// Escena surrealista generada 100% con CSS/SVG (sin imágenes externas).
---
<section class="hero" id="index">
  <div class="scene" aria-hidden="true">
    <div class="sky"></div>
    <div class="wall wall--back">
      <div class="window window--tall"></div>
      <div class="window window--short"></div>
    </div>
    <div class="wall wall--left">
      <div class="arch"><div class="arch__field"></div></div>
      <div class="arch arch--far"></div>
    </div>
    <div class="ledge"></div>
    <div class="stairs">{Array.from({ length: 7 }, (_, i) => <span style={`--s:${i}`}></span>)}</div>
    <div class="orb"></div>
    <div class="stone stone--a"></div>
    <div class="stone stone--b"></div>
    <div class="water"></div>
    <div class="light"></div>
  </div>

  <svg width="0" height="0" style="position:absolute">
    <filter id="ripple">
      <feTurbulence type="fractalNoise" baseFrequency="0.004 0.04" numOctaves="2" seed="3">
        <animate attributeName="baseFrequency" dur="14s" values="0.004 0.04;0.006 0.05;0.004 0.04" repeatCount="indefinite" />
      </feTurbulence>
      <feDisplacementMap in="SourceGraphic" scale="28" />
    </filter>
  </svg>

  <div class="hero__copy">
    <p class="eyebrow reveal">A brand, digital &amp; motion studio</p>
    <h1>
      <span class="line line--serif"><span>Designing the</span></span>
      <span class="line line--sans"><span>improbable</span></span>
    </h1>
    <a href="#projects" class="pill pill--solid reveal cta">View our work <span aria-hidden="true">↘</span></a>
  </div>

  <div class="hero__bar">
    <div class="hero__bar-left">
      <button class="icon-btn" aria-label="Sonido"><span class="eq"><i></i><i></i><i></i><i></i></span></button>
      <a href="#studio" class="pill pill--ghost">Our 2026 Recap</a>
    </div>
    <button class="icon-btn" aria-label="Idioma">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18M5 7h14M5 17h14"/></svg>
    </button>
    <span class="copy">©{new Date().getFullYear()}</span>
  </div>
</section>

<script>
  const scene = document.querySelector<HTMLElement>('.scene')!;
  addEventListener('mousemove', (e) => {
    const x = e.clientX / innerWidth - 0.5, y = e.clientY / innerHeight - 0.5;
    scene.style.setProperty('--mx', String(x));
    scene.style.setProperty('--my', String(y));
  });
  requestAnimationFrame(() => document.querySelector('.hero')!.classList.add('is-loaded'));
</script>

<style>
  .hero { position: relative; height: 100svh; min-height: 620px; overflow: hidden; color: var(--ink); }

  /* ---------- escena ---------- */
  .scene {
    --mx: 0; --my: 0;
    position: absolute; inset: -3%;
    transform: translate(calc(var(--mx) * -24px), calc(var(--my) * -16px)) scale(1.04);
    transition: transform 1.2s var(--ease);
    animation: zoom 3s var(--ease) both;
    filter: saturate(.92) blur(.3px);
  }
  @keyframes zoom { from { transform: scale(1.18); filter: blur(12px); } }
  .sky { position: absolute; inset: 0; background: linear-gradient(180deg, #a6b8f2, #d9d2f0 60%, #f1d9dc); }
  .wall { position: absolute; }
  .wall--back {
    inset: 0 0 30% 22%;
    background:
      radial-gradient(120% 90% at 70% 10%, rgba(255,255,255,.35), transparent 60%),
      linear-gradient(115deg, transparent 38%, rgba(160,110,110,.18) 38.2%, rgba(160,110,110,.18) 52%, transparent 52.2%),
      linear-gradient(180deg, #ecc9c4, #e2b8b3);
  }
  .window { position: absolute; background: linear-gradient(180deg, #9fb7f5, #cfd8fb 70%, #eadff4); box-shadow: inset 10px 0 0 rgba(170,120,115,.35), inset 0 10px 0 rgba(170,120,115,.25); }
  .window--tall { left: 50%; top: 11%; width: 8%; height: 46%; }
  .window--short { left: 31%; top: 39%; width: 6%; height: 30%; }
  .wall--left {
    inset: 0 auto 26% 0; width: 25%;
    background: linear-gradient(90deg, #d4a9a5, #e8c3be 70%, #dcb0ab);
    clip-path: polygon(0 0, 100% 6%, 100% 100%, 0 100%);
  }
  .arch {
    position: absolute; left: 30%; bottom: 0; width: 48%; height: 62%;
    border-radius: 999px 999px 0 0; overflow: hidden;
    background: linear-gradient(180deg, #b8c0f2, #e5cfe8);
    box-shadow: inset 12px 0 0 rgba(255,235,230,.6);
  }
  .arch__field { position: absolute; inset: 55% -10% 0; background: radial-gradient(ellipse at 40% 0, #c9a3cc, #a986b3); border-radius: 50% 50% 0 0; }
  .arch--far { left: -18%; width: 30%; height: 70%; }
  .ledge { position: absolute; left: 22%; right: 0; top: 56%; height: 16%; background: linear-gradient(180deg, #f0d2cd, #e0b9b4); box-shadow: 0 -2px 0 rgba(255,255,255,.5); }
  .stairs { position: absolute; left: 24%; top: 58%; width: 32%; height: 16%; display: flex; flex-direction: column; }
  .stairs span {
    flex: 1; margin-left: calc((6 - var(--s)) * 2.2%); margin-right: calc((6 - var(--s)) * 1.2%);
    background: linear-gradient(180deg, #fbebe7 0 28%, #e9c6c1 30%);
    border-radius: 2px;
  }
  .orb {
    position: absolute; left: 55%; top: 42%; width: 8.5%; aspect-ratio: 1; border-radius: 50%;
    background:
      radial-gradient(circle at 32% 28%, #fff 0 8%, transparent 26%),
      conic-gradient(from 200deg, #f6d5f0, #cde4ff, #fbf0c9, #d8ccff, #ffd7e6, #f6d5f0);
    box-shadow: inset -12px -16px 30px rgba(150,120,170,.35), 0 20px 40px rgba(140,90,100,.2);
    animation: float 7s ease-in-out infinite;
  }
  @keyframes float { 50% { transform: translateY(-10px) rotate(8deg); } }
  .stone { position: absolute; border-radius: 48% 52% 40% 44% / 60% 58% 30% 32%; background: radial-gradient(circle at 40% 30%, #e6cfbf, #b89582 70%); }
  .stone--a { left: 62%; top: 64%; width: 15%; height: 13%; }
  .stone--b { right: -2%; top: 70%; width: 17%; height: 15%; }
  .water {
    position: absolute; inset: 70% 0 0;
    background:
      linear-gradient(180deg, rgba(240,205,205,.85), rgba(205,190,225,.9) 40%, rgba(225,215,240,.95)),
      repeating-linear-gradient(180deg, rgba(255,255,255,.25) 0 2px, transparent 2px 14px);
    filter: url(#ripple);
    backdrop-filter: blur(2px);
  }
  .light { position: absolute; inset: 0; background: radial-gradient(60% 50% at 50% 40%, rgba(255,240,235,.35), transparent 70%), radial-gradient(120% 90% at 50% 50%, transparent 55%, rgba(80,40,60,.25)); }

  /* ---------- copy ---------- */
  .hero__copy {
    position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 0 16px; z-index: 2;
  }
  .eyebrow { font-size: 1rem; letter-spacing: .02em; text-transform: uppercase; margin-bottom: .6rem; transition-delay: .6s; }
  h1 { display: flex; flex-direction: column; align-items: center; line-height: .9; font-weight: 400; }
  .line { display: block; overflow: hidden; padding: 0 .1em .08em; }
  .line > span { display: block; transform: translateY(110%); transition: transform 1.6s var(--ease); }
  .line--serif { font-family: var(--serif); font-style: italic; font-size: clamp(3.2rem, 8vw, 7.2rem); letter-spacing: -.03em; }
  .line--sans { font-family: var(--sans); font-weight: 400; font-size: clamp(3.4rem, 8.6vw, 7.8rem); letter-spacing: -.06em; }
  .line--serif > span { transition-delay: .5s; }
  .line--sans > span { transition-delay: .65s; }
  :global(.hero.is-loaded) .line > span { transform: none; }
  .cta { margin-top: 2.2rem; transition-delay: .9s; }

  /* ---------- barra inferior ---------- */
  .hero__bar {
    position: absolute; left: 0; right: 0; bottom: 0; z-index: 3; padding: 1.6rem 2.2rem;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
  }
  .hero__bar-left { display: flex; gap: 1.2rem; align-items: center; }
  .copy { justify-self: end; color: #fff; font-size: .95rem; }
  .eq { display: flex; align-items: flex-end; gap: 2px; height: 12px; }
  .eq i { width: 2px; background: var(--ink); animation: eq 1s ease-in-out infinite; }
  .eq i:nth-child(1) { animation-delay: -.2s; } .eq i:nth-child(2) { animation-delay: -.6s; }
  .eq i:nth-child(3) { animation-delay: -.4s; } .eq i:nth-child(4) { animation-delay: -.8s; }
  @keyframes eq { 0%, 100% { height: 30%; } 50% { height: 100%; } }

  @media (max-width: 700px) {
    .hero__bar { padding: 1.1rem 16px; }
    .hero__bar .pill--ghost { display: none; }
  }
</style>
