---
import { CHANNELS } from '../scripts/nube-scene';
---
<section class="hero" id="inicio">
  <canvas class="webgl" aria-label="Escena 3D: una nube voladora lleva una tele retro sobre un valle al atardecer"></canvas>

  <div class="hero__copy">
    <p class="eyebrow reveal">Contenido · Edicion · Motion</p>
    <h1 class="pixel">
      <span class="line"><span>Nube</span></span>
      <span class="line line--accent"><span>Voladora</span></span>
    </h1>
    <p class="lede reveal">Le damos alas a tus videos. Creamos contenido original para tu marca o editamos tu material para que vuele en cada pantalla.</p>
    <div class="ctas reveal">
      <a href="#trabajos" class="btn btn--cyan">Ver reel ▶</a>
      <a href="#contacto" class="btn btn--ghost">Cotizar proyecto</a>
    </div>
  </div>

  <div class="hero__bar">
    <div class="tuner" role="group" aria-label="Canales de la tele">
      <button class="tuner__btn" data-dir="-1" aria-label="Canal anterior">◀</button>
      <p class="tuner__label pixel" aria-live="polite">
        <span class="tuner__num">01</span> / {String(CHANNELS.length).padStart(2, '0')} — <span class="tuner__name">{CHANNELS[0].name}</span>
      </p>
      <button class="tuner__btn" data-dir="1" aria-label="Canal siguiente">▶</button>
    </div>
    <a href="#servicios" class="scroll-cue" aria-label="Bajar a servicios">
      <span class="scroll-cue__arrow" aria-hidden="true">
        <svg width="18" height="22" viewBox="0 0 9 11" shape-rendering="crispEdges"><path fill="currentColor" d="M3 0h3v6h3v1H8v1H7v1H6v1H5v1H4v-1H3V9H2V8H1V7H0V6h3z" /></svg>
      </span>
      <span class="pixel">Scroll</span>
    </a>
  </div>
</section>

<script>
  import { createNubeScene, CHANNELS } from '../scripts/nube-scene';

  const hero = document.querySelector<HTMLElement>('.hero')!;
  const scene = createNubeScene(hero.querySelector('canvas')!);
  (window as any).nube = scene;

  const num = hero.querySelector('.tuner__num')!;
  const name = hero.querySelector('.tuner__name')!;
  scene.onChannel((ch) => {
    num.textContent = String(ch + 1).padStart(2, '0');
    name.textContent = CHANNELS[ch].name;
    document.querySelectorAll('[data-channel]').forEach((el) =>
      el.classList.toggle('is-active', Number((el as HTMLElement).dataset.channel) === ch),
    );
  });
  hero.querySelectorAll<HTMLButtonElement>('.tuner__btn').forEach((b) =>
    b.addEventListener('click', () => (b.dataset.dir === '1' ? scene.next() : scene.prev())),
  );
  addEventListener('keydown', (e) => {
    if (scrollY > innerHeight * 0.6) return;
    if (e.key === 'ArrowRight') scene.next();
    if (e.key === 'ArrowLeft') scene.prev();
  });

  // las tarjetas de servicios sintonizan la tele (sin mover el scroll)
  document.querySelectorAll<HTMLElement>('[data-channel]').forEach((el) =>
    el.addEventListener('click', () => scene.setChannel(Number(el.dataset.channel))),
  );

  const onScroll = () => {
    const p = Math.min(Math.max(scrollY / hero.offsetHeight, 0), 1);
    scene.setScroll(p);
    hero.style.setProperty('--p', String(p));
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  requestAnimationFrame(() => hero.classList.add('is-loaded'));
</script>

<style>
  .hero { --p: 0; position: relative; height: 100svh; min-height: 640px; overflow: hidden; background: var(--ink); }
  /* fundido hacia la sección siguiente: sin línea de corte */
  .hero::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 38%; z-index: 1; pointer-events: none;
    background: linear-gradient(180deg, rgba(7,17,57,0) 0%, rgba(7,17,57,.55) 45%, rgba(7,17,57,.9) 75%, var(--ink) 100%);
  }
  .webgl { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: pan-y; }

  .hero__copy {
    position: absolute; left: clamp(16px, 5vw, 4rem); top: 50%; transform: translateY(calc(-50% - var(--p) * 80px));
    max-width: 44rem; z-index: 2; pointer-events: none; opacity: calc(1 - var(--p) * 1.8);
  }
  .hero__copy a { pointer-events: auto; }
  h1 { font-size: clamp(1.8rem, 4.2vw, 3.6rem); line-height: 1.12; margin: 1rem 0 1.4rem; text-shadow: 0 4px 0 var(--ink); }
  .line { display: block; overflow: hidden; padding-bottom: .1em; }
  .line > span { display: block; transform: translateY(110%); transition: transform 1.2s var(--ease) 1.6s; }
  .line--accent > span { color: var(--cyan); transition-delay: 1.75s; text-shadow: 0 0 24px rgba(97,247,231,.45), 0 4px 0 var(--ink); }
  :global(.hero.is-loaded) .line > span { transform: none; }
  .lede { font-size: 1.02rem; max-width: 30rem; text-shadow: 0 2px 10px rgba(7,17,57,.8); }
  .ctas { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2rem; }
  .eyebrow { transition-delay: 1.4s; }
  .lede { transition-delay: 1.9s; }
  .ctas { transition-delay: 2.05s; }
  .btn--ghost { background: rgba(7,17,57,.45); backdrop-filter: blur(6px); }

  .hero__bar {
    position: absolute; left: 0; right: 0; bottom: 0; z-index: 3; padding: 1.2rem clamp(16px, 4vw, 2.5rem);
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem;
  }
  .tuner { display: flex; align-items: center; gap: .6rem; }
  .tuner__btn {
    width: 34px; height: 34px; display: grid; place-items: center; font-size: .7rem;
    border: 2px solid var(--cyan); color: var(--cyan); transition: background .2s, color .2s;
  }
  .tuner__btn:hover { background: var(--cyan); color: var(--ink); }
  .tuner__label { font-size: .6rem; min-width: 15ch; }
  .tuner__num { color: var(--cyan); }
  .scroll-cue { display: flex; flex-direction: column; align-items: center; gap: .55rem; color: var(--cyan); font-size: .55rem; letter-spacing: .14em; }
  .scroll-cue__arrow { display: block; animation: cue 1.6s steps(4) infinite; filter: drop-shadow(0 0 6px rgba(97,247,231,.6)); }
  .scroll-cue:hover { color: var(--cream); }
  @keyframes cue { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(6px); } }

  @media (max-width: 860px) {
    .hero__copy { top: auto; bottom: 6.5rem; transform: translateY(calc(var(--p) * -80px)); right: 16px; }
    h1 { font-size: clamp(1.7rem, 8vw, 2.6rem); margin: .6rem 0 .8rem; }
    .lede { font-size: .9rem; }
    .ctas { margin-top: 1.2rem; }
    .hero__bar { grid-template-columns: 1fr auto; }
    .scroll-cue { flex-direction: row; }
  }
</style>
