<section class="hero" id="index">
  <canvas class="webgl" aria-label="Escena 3D interactiva: arquitectura surrealista sobre agua"></canvas>

  <div class="hero__copy">
    <p class="eyebrow reveal">A brand, digital &amp; motion studio</p>
    <h1>
      <span class="line line--serif"><span>Designing the</span></span>
      <span class="line line--sans"><span>improbable</span></span>
    </h1>
    <a href="#projects" class="pill pill--solid reveal cta">View our work <span aria-hidden="true">↘</span></a>
  </div>

  <p class="hint">Tocá el agua · hacé click en la esfera</p>

  <div class="hero__bar">
    <div class="hero__bar-left">
      <button class="icon-btn" aria-label="Sonido"><span class="eq"><i></i><i></i><i></i><i></i></span></button>
      <a href="#studio" class="pill pill--ghost">Our 2026 Recap</a>
    </div>
    <button class="icon-btn light-toggle" aria-label="Cambiar a atardecer" aria-pressed="false">
      <svg class="sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"/></svg>
    </button>
    <span class="copy">©{new Date().getFullYear()}</span>
  </div>
</section>

<script>
  import { createScene } from '../scripts/scene';

  const hero = document.querySelector<HTMLElement>('.hero')!;
  const canvas = hero.querySelector<HTMLCanvasElement>('.webgl')!;
  const scene = createScene(canvas);

  const toggle = hero.querySelector<HTMLButtonElement>('.light-toggle')!;
  toggle.addEventListener('click', () => {
    const dusk = scene.preset !== 'dusk';
    scene.setPreset(dusk ? 'dusk' : 'day');
    toggle.setAttribute('aria-pressed', String(dusk));
    toggle.setAttribute('aria-label', dusk ? 'Cambiar a día' : 'Cambiar a atardecer');
    hero.classList.toggle('is-dusk', dusk);
  });

  const onScroll = () => {
    const p = Math.min(Math.max(scrollY / hero.offsetHeight, 0), 1);
    scene.setScroll(p);
    hero.style.setProperty('--p', String(p));
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  requestAnimationFrame(() => hero.classList.add('is-loaded'));
</script>

<style>
  .hero { --p: 0; position: relative; height: 100svh; min-height: 620px; overflow: hidden; color: var(--ink); background: #efd3d6; }
  .webgl { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: pan-y; }

  .hero__copy {
    position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 0 16px; z-index: 2; pointer-events: none;
    opacity: calc(1 - var(--p) * 1.8); transform: translateY(calc(var(--p) * -80px));
    transition: color 1.5s var(--ease);
  }
  .hero__copy a { pointer-events: auto; }
  .eyebrow { font-size: 1rem; letter-spacing: .02em; text-transform: uppercase; margin-bottom: .6rem; transition-delay: 1.4s; }
  h1 { display: flex; flex-direction: column; align-items: center; line-height: .9; font-weight: 400; }
  .line { display: block; overflow: hidden; padding: 0 .1em .08em; }
  .line > span { display: block; transform: translateY(110%); transition: transform 1.6s var(--ease); }
  .line--serif { font-family: var(--serif); font-style: italic; font-size: clamp(3.2rem, 8vw, 7.2rem); letter-spacing: -.03em; }
  .line--sans { font-family: var(--sans); font-weight: 400; font-size: clamp(3.4rem, 8.6vw, 7.8rem); letter-spacing: -.06em; }
  .line--serif > span { transition-delay: 1.2s; }
  .line--sans > span { transition-delay: 1.35s; }
  :global(.hero.is-loaded) .line > span { transform: none; }
  .cta { margin-top: 2.2rem; transition-delay: 1.7s; }
  .is-dusk .hero__copy, :global(.is-dusk) .hint { color: #fff7f3; }

  .hint {
    position: absolute; left: 50%; bottom: 6.2rem; transform: translateX(-50%); z-index: 2;
    font-size: .8rem; letter-spacing: .06em; text-transform: uppercase; color: var(--ink); opacity: .7;
    pointer-events: none; animation: hint 1s var(--ease) 3s both;
  }
  @keyframes hint { from { opacity: 0; transform: translate(-50%, 10px); } }

  .hero__bar {
    position: absolute; left: 0; right: 0; bottom: 0; z-index: 3; padding: 1.6rem 2.2rem;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
  }
  .hero__bar-left { display: flex; gap: 1.2rem; align-items: center; }
  .copy { justify-self: end; color: #fff; font-size: .95rem; }
  .eq { display: flex; align-items: flex-end; gap: 2px; height: 12px; }
  .eq i { width: 2px; background: var(--ink); animation: eq 1s ease-in-out infinite; }
  .eq i:nth-child(1) { animation-delay: -.2s; } .eq i:nth-child(2) { animation-delay: -.6s; }
  .eq i:nth-child(3) { animation-delay: -.4s; } .eq i:nth-child(4) { animation-delay: -.8s; }
  @keyframes eq { 0%, 100% { height: 30%; } 50% { height: 100%; } }
  .light-toggle .moon { display: none; }
  :global(.is-dusk) .light-toggle .sun { display: none; }
  :global(.is-dusk) .light-toggle .moon { display: block; }

  @media (max-width: 700px) {
    .hero__bar { padding: 1.1rem 16px; }
    .hero__bar .pill--ghost { display: none; }
  }
</style>
