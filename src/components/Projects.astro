---
const projects = [
  { name: 'Halcyon', tags: 'Brand · Motion', year: 2026, hue: '#c9c3e6, #f1d1d6' },
  { name: 'Northbound', tags: 'Digital · 3D', year: 2026, hue: '#a9bff0, #e6d7f3' },
  { name: 'Sora Labs', tags: 'Identity', year: 2025, hue: '#f0d9c4, #d9b1ae' },
  { name: 'Quiet Matter', tags: 'Website · WebGL', year: 2025, hue: '#d5e6dc, #c9c3e6' },
  { name: 'Velour', tags: 'Campaign · Motion', year: 2025, hue: '#e8b7c2, #f6e0c9' },
  { name: 'Atlas Bloom', tags: 'Brand · Digital', year: 2024, hue: '#bfd4f2, #f3e6e3' },
];
---
<section class="projects" id="projects">
  <header class="projects__head reveal">
    <h2><em>Selected</em> work</h2>
    <p>Marcas, productos digitales y piezas de motion para equipos que quieren ser recordados.</p>
  </header>
  <ul class="grid">
    {projects.map((p, i) => (
      <li class="card reveal" style={`transition-delay:${(i % 2) * 0.12}s`}>
        <a href="#contact">
          <div class="card__media" style={`--g:${p.hue}`}>
            <div class="card__shape"></div>
          </div>
          <div class="card__meta">
            <h3>{p.name}</h3>
            <span>{p.tags}</span>
            <span>{p.year}</span>
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>
<style>
  .projects { padding: 10rem 2.2rem 6rem; }
  .projects__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; flex-wrap: wrap; margin-bottom: 4rem; }
  h2 { font-weight: 400; font-size: clamp(3rem, 8vw, 7rem); letter-spacing: -.05em; line-height: .9; }
  h2 em { font-family: var(--serif); letter-spacing: -.02em; }
  .projects__head p { max-width: 28ch; font-size: 1.05rem; line-height: 1.45; }
  .grid { list-style: none; display: grid; grid-template-columns: repeat(2, 1fr); gap: 4rem 2rem; }
  .card:nth-child(even) { margin-top: 8rem; }
  .card__media { position: relative; aspect-ratio: 4 / 5; border-radius: 6px; overflow: hidden; background: linear-gradient(160deg, var(--g)); }
  .card__shape {
    position: absolute; inset: 22% 22%; border-radius: 999px 999px 0 0;
    background: linear-gradient(180deg, rgba(255,255,255,.55), rgba(255,255,255,.1));
    box-shadow: 0 30px 60px rgba(80,50,70,.15); transition: transform 1.2s var(--ease), border-radius 1.2s var(--ease);
  }
  .card a:hover .card__shape { transform: scale(1.12) rotate(-3deg); border-radius: 50%; }
  .card__meta { display: grid; grid-template-columns: 1fr auto auto; gap: 1.5rem; align-items: baseline; padding-top: 1rem; font-size: .95rem; }
  .card__meta h3 { font-family: var(--serif); font-weight: 400; font-size: 1.8rem; }
  @media (max-width: 760px) {
    .projects { padding: 6rem 16px 4rem; }
    .grid { grid-template-columns: 1fr; }
    .card:nth-child(even) { margin-top: 0; }
  }
</style>
