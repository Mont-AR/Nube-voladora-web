<canvas class="backdrop" aria-hidden="true"></canvas>
<div class="crt" aria-hidden="true"></div>

<script>
  // cielo pixelado detrás de las secciones: el color cambia con el recorrido,
  // las estrellas y nubes hacen parallax y al scrollear rápido se estiran (efecto warp)
  const canvas = document.querySelector<HTMLCanvasElement>('.backdrop')!;
  const ctx = canvas.getContext('2d')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const SKY = [[7, 17, 57], [13, 10, 61], [24, 12, 78], [52, 14, 88]];
  const COLORS = ['#fff6d9', '#61f7e7', '#b48cff', '#ffb77e', '#e42a9b'];
  const PX = 3;

  type Star = { x: number; y: number; z: number; c: string; s: number; ph: number };
  type Cloud = { x: number; y: number; z: number; w: number; v: number };
  let w = 0, h = 0, stars: Star[] = [], clouds: Cloud[] = [];
  let lastY = scrollY, vel = 0;

  const resize = () => {
    const dpr = Math.min(devicePixelRatio, 1.5);
    w = innerWidth; h = innerHeight;
    canvas.width = w * dpr; canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.imageSmoothingEnabled = false;
    const n = Math.round((w * h) / 6500);
    stars = Array.from({ length: n }, () => {
      const z = Math.random();
      return { x: Math.random() * w, y: Math.random() * h, z, c: COLORS[(Math.random() ** 2 * COLORS.length) | 0], s: z > 0.85 ? PX * 2 : PX, ph: Math.random() * 6.3 };
    });
    clouds = Array.from({ length: 5 }, (_, i) => ({ x: Math.random() * w, y: (i / 5) * h * 1.6, z: 0.15 + Math.random() * 0.25, w: 14 + ((Math.random() * 14) | 0), v: 0.08 + Math.random() * 0.12 }));
  };

  const mix = (p: number) => {
    const t = Math.min(Math.max(p, 0), 1) * (SKY.length - 1);
    const i = Math.min(SKY.length - 2, Math.floor(t)), f = t - i;
    return SKY[i].map((v, k) => Math.round(v + (SKY[i + 1][k] - v) * f));
  };

  // nube pixel: bloques escalonados como el logo
  const drawCloud = (x: number, y: number, cw: number) => {
    const u = PX * 3;
    const rows = [[3, cw - 6], [1, cw - 2], [0, cw]];
    rows.forEach(([o, len], r) => ctx.fillRect(Math.round(x + o * u), Math.round(y + r * u), len * u, u));
  };

  let painted = -1;
  const frame = (t: number) => {
    requestAnimationFrame(frame);
    const y = scrollY;
    vel += ((y - lastY) - vel) * 0.2;
    lastY = y;
    // en el hero solo hay color plano: se repinta únicamente si cambió el scroll
    const still = y <= h * 0.4;
    if (still && y === painted) return;
    painted = still ? y : -1;
    const max = document.documentElement.scrollHeight - h;
    const [r, g, b] = mix(y / (max || 1));
    ctx.fillStyle = `rgb(${r},${g},${b})`;
    ctx.fillRect(0, 0, w, h);

    if (y > h * 0.4) {
      ctx.fillStyle = 'rgba(180,140,255,.05)';
      for (const c of clouds) {
        c.x += reduced ? 0 : c.v;
        const cx = ((c.x % (w + 400)) + w + 400) % (w + 400) - 300;
        const cy = ((c.y - y * c.z) % (h + 200) + h + 200) % (h + 200) - 100;
        drawCloud(cx, cy, c.w);
      }

      const warp = reduced ? 0 : Math.min(Math.abs(vel) * 1.1, 90);
      for (const s of stars) {
        const sy = ((s.y - y * (0.05 + s.z * 0.3)) % h + h) % h;
        const tw = reduced ? 1 : 0.55 + 0.45 * Math.sin(t * 0.002 + s.ph);
        ctx.globalAlpha = (0.25 + s.z * 0.6) * tw;
        ctx.fillStyle = s.c;
        const len = warp * (0.2 + s.z);
        ctx.fillRect(Math.round(s.x / PX) * PX, Math.round((vel > 0 ? sy : sy - len) / PX) * PX, s.s, s.s + Math.round(len / PX) * PX);
      }
      ctx.globalAlpha = 1;
    }
  };

  addEventListener('resize', () => { resize(); painted = -1; });
  resize();
  requestAnimationFrame(frame);
</script>

<style>
  .backdrop { position: fixed; inset: 0; width: 100vw; height: 100vh; z-index: -1; pointer-events: none; image-rendering: pixelated; }
  /* scanlines y viñeta de tele vieja, muy suaves */
  .crt {
    position: fixed; inset: 0; z-index: 60; pointer-events: none;
    background:
      repeating-linear-gradient(0deg, rgba(7, 17, 57, .09) 0 1px, transparent 1px 3px),
      radial-gradient(130% 100% at 50% 50%, transparent 65%, rgba(7, 17, 57, .45));
  }
</style>
