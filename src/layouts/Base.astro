---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Cursor from '../components/Cursor.astro';
import Backdrop from '../components/Backdrop.astro';
import Footer from '../components/Footer.astro';

interface Props { title?: string; description?: string }
const {
  title = 'Nube Voladora — Edición de video y contenido',
  description = 'Estudio de edición de video, motion y contenido para redes. Le damos alas a tus videos.',
} = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#071139" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <Backdrop />
    <Header />
    <slot />
    <Footer />
    <Cursor />
    <script>
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
      }, { threshold: 0.15 });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
